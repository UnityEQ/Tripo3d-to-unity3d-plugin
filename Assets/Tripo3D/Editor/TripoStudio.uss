.studio {
    flex-grow: 1;
    background-color: #1c1d24;
    color: #ececf1;
    padding: 12px 16px 16px 16px;
}

.header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #f4f4f8;
}

.subtitle {
    margin-left: 10px;
    font-size: 11px;
    color: #8b8e9a;
}

.spacer {
    flex-grow: 1;
}

.balance {
    font-size: 12px;
    color: #c6c8d2;
    margin-right: 8px;
}

.header-provider {
    min-width: 180px;
    max-width: 220px;
    margin-right: 10px;
}

.ghost-btn {
    height: 24px;
    background-color: #2d2e38;
    color: #ececf1;
    border-radius: 6px;
    border-width: 0;
    padding-left: 10px;
    padding-right: 10px;
}

.ghost-btn:hover {
    background-color: #3a3b47;
}

.tabs {
    flex-direction: row;
    margin-bottom: 12px;
}

.tab {
    height: 28px;
    margin-right: 6px;
    background-color: #25262e;
    color: #b7bac6;
    border-radius: 8px;
    border-width: 0;
    padding-left: 12px;
    padding-right: 12px;
}

.tab:hover {
    background-color: #30313b;
    color: #ececf1;
}

.tab--active {
    background-color: #3a2a28;
    color: #ffd4ce;
}

.page {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    min-width: 0;
}

.row {
    flex-direction: row;
    flex-grow: 1;
    align-items: stretch;
    min-height: 0;
}

.image-col {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 320px;
    width: 0;
}

.image-col--last {
    margin-right: 0;
}

.image-col-scroll {
    flex-grow: 1;
    min-height: 0;
}

.card {
    flex-grow: 1;
    background-color: #25262e;
    border-radius: 12px;
    border-width: 1px;
    border-color: #32333d;
    padding: 12px;
    margin-right: 10px;
    min-width: 0;
    overflow: hidden;
}

.card.image-col {
    min-width: 320px;
    width: 0;
    flex-basis: 0;
}

.card-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #f0f0f5;
    margin-bottom: 8px;
}

.hint {
    color: #8b8e9a;
    font-size: 11px;
    white-space: normal;
    margin-bottom: 8px;
}

.drop-zone {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 220px;
    height: 0;
    background-color: #1a1b22;
    border-radius: 10px;
    border-width: 1px;
    border-color: #3a3b47;
    align-items: stretch;
    justify-content: flex-start;
    padding: 8px;
    overflow: hidden;
}

.preview {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 180px;
    -unity-background-scale-mode: scale-to-fit;
}

.file-name {
    margin-top: 8px;
    color: #aeb1bd;
    font-size: 11px;
}

.generate-btn {
    height: 36px;
    margin-top: 10px;
    background-color: #e86b5a;
    color: #ffffff;
    border-radius: 8px;
    border-width: 0;
    -unity-font-style: bold;
    font-size: 13px;
}

.generate-btn:hover {
    background-color: #f07a6a;
}

.generate-btn:disabled {
    background-color: #5a3b37;
    color: #c7b0ac;
}

.btn-row {
    flex-direction: row;
    margin-top: 6px;
}

.btn-row > .secondary-btn {
    margin-top: 0;
    margin-right: 6px;
}

.secondary-btn {
    height: 28px;
    margin-top: 6px;
    background-color: #32333d;
    color: #ececf1;
    border-radius: 8px;
    border-width: 0;
}

.secondary-btn:hover {
    background-color: #3d3e4a;
}

.progress {
    margin-top: 10px;
    height: 8px;
}

.status {
    margin-top: 8px;
    color: #c6c8d2;
    font-size: 11px;
    white-space: normal;
}

.result-image {
    margin-top: 8px;
    height: 180px;
    width: 100%;
    flex-shrink: 0;
    background-color: #1a1b22;
    border-radius: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.field-label {
    margin-top: 6px;
    margin-bottom: 2px;
    color: #b7bac6;
    font-size: 11px;
}

.job-row {
    flex-direction: column;
    padding: 8px;
    margin-bottom: 6px;
    background-color: #1a1b22;
    border-radius: 8px;
}

.job-top {
    flex-direction: row;
    align-items: center;
}

.job-name {
    flex-grow: 1;
    color: #ececf1;
}

.job-meta {
    color: #8b8e9a;
    font-size: 11px;
    flex-shrink: 0;
}

.job-path {
    color: #8b8e9a;
    font-size: 11px;
    margin-top: 4px;
    white-space: normal;
}

.job-path--missing {
    color: #f0c36a;
}

.warning {
    color: #f0c36a;
    font-size: 11px;
    white-space: normal;
    margin-top: 8px;
}

.mv-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.mv-cell {
    width: 48%;
    height: 140px;
    margin-right: 4px;
    margin-bottom: 8px;
    background-color: #1a1b22;
    border-radius: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.prop-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    margin-bottom: 4px;
    background-color: #1a1b22;
    border-radius: 6px;
}

.prop-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
}

.prop-card {
    width: 48%;
    margin-right: 4px;
    margin-bottom: 8px;
    background-color: #1a1b22;
    border-radius: 8px;
    padding: 8px;
}

.prop-preview {
    height: 120px;
    -unity-background-scale-mode: scale-to-fit;
}
